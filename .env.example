# DevAuthKit Environment Configuration

# Session Secret (Required in production)
SESSION_SECRET=your_random_session_secret_here

# JWT Secret (Defaults to SESSION_SECRET if not provided)
JWT_SECRET=your_random_jwt_secret_here

# Optional: Production SMTP credentials (Leave blank for local console Dev Mode)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Optional: Google OAuth credentials (also configure GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, and the callback URL in devAuthKit options).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
