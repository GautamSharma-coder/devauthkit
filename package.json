{
  "name": "devauthkit",
  "version": "1.2.0",
  "description": "A plug-and-play authentication service for developers",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client/index.d.ts",
      "default": "./client/index.js"
    }
  },
  "files": [
    "server",
    "client",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node example.js",
    "dev": "nodemon example.js",
    "test": "node test_auth.js",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GautamSharma-coder/devauthkit.git"
  },
  "bugs": {
    "url": "https://github.com/GautamSharma-coder/devauthkit/issues"
  },
  "homepage": "https://github.com/GautamSharma-coder/devauthkit#readme",
  "keywords": [
    "auth",
    "authentication",
    "express",
    "jwt",
    "session",
    "email",
    "otp",
    "passwordless",
    "sdk"
  ],
  "author": "Gautam Sharma",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.7"
  }
}
