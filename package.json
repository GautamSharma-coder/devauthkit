{
  "name": "devauthkit",
  "version": "1.10.3",
  "description": "A plug-and-play authentication service for developers",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client/index.d.ts",
      "default": "./client/index.js"
    },
    "./adapters/prisma": {
      "types": "./server/adapters/prisma.d.ts",
      "default": "./server/adapters/prisma.js"
    },
    "./adapters/drizzle": {
      "types": "./server/adapters/drizzle.d.ts",
      "default": "./server/adapters/drizzle.js"
    },
    "./adapters/mongoose": {
      "types": "./server/adapters/mongoose.d.ts",
      "default": "./server/adapters/mongoose.js"
    },
    "./hono": {
      "types": "./server/hono/index.d.ts",
      "default": "./server/hono/index.js"
    },
    "./stores/cloudflare-kv": {
      "types": "./server/stores/cloudflareKvStore.d.ts",
      "default": "./server/stores/cloudflareKvStore.js"
    },
    "./stores/cloudflare-d1": {
      "types": "./server/stores/cloudflareD1RefreshTokenStore.d.ts",
      "default": "./server/stores/cloudflareD1RefreshTokenStore.js"
    },
    "./stores/cloudflare-d1-oauth-state": {
      "types": "./server/stores/cloudflareD1OAuthStateStore.d.ts",
      "default": "./server/stores/cloudflareD1OAuthStateStore.js"
    },
    "./stores/cloudflare-d1-counter": {
      "types": "./server/stores/cloudflareD1CounterStore.d.ts",
      "default": "./server/stores/cloudflareD1CounterStore.js"
    },
    "./stores/cloudflare-d1-passkeys": {
      "types": "./server/stores/cloudflareD1PasskeyStore.d.ts",
      "default": "./server/stores/cloudflareD1PasskeyStore.js"
    },
    "./stores/cloudflare-d1-dpop-replay": {
      "types": "./server/stores/cloudflareD1DpopReplayStore.d.ts",
      "default": "./server/stores/cloudflareD1DpopReplayStore.js"
    },
    "./stores/redis-dpop-replay": {
      "types": "./server/stores/redisDpopReplayStore.d.ts",
      "default": "./server/stores/redisDpopReplayStore.js"
    },
    "./stores/redis-refresh-tokens": {
      "types": "./server/stores/redisRefreshTokenStore.d.ts",
      "default": "./server/stores/redisRefreshTokenStore.js"
    },
    "./stores/cloudflare-d1-organizations": {
      "types": "./server/stores/cloudflareD1OrganizationStore.d.ts",
      "default": "./server/stores/cloudflareD1OrganizationStore.js"
    },
    "./organizations": {
      "types": "./server/core/organizationService.d.ts",
      "default": "./server/core/organizationService.js"
    },
    "./stores/memory-organizations": {
      "types": "./server/stores/memoryOrganizationStore.d.ts",
      "default": "./server/stores/memoryOrganizationStore.js"
    },
    "./webhooks": {
      "types": "./server/core/webhookService.d.ts",
      "default": "./server/core/webhookService.js"
    },
    "./stores/cloudflare-d1-webhooks": {
      "types": "./server/stores/cloudflareD1WebhookStore.d.ts",
      "default": "./server/stores/cloudflareD1WebhookStore.js"
    },
    "./stores/memory-webhooks": {
      "types": "./server/stores/memoryWebhookStore.d.ts",
      "default": "./server/stores/memoryWebhookStore.js"
    },
    "./sso": {
      "types": "./server/core/ssoService.d.ts",
      "default": "./server/core/ssoService.js"
    },
    "./scim": {
      "types": "./server/core/scimService.d.ts",
      "default": "./server/core/scimService.js"
    },
    "./stores/memory-sso": {
      "types": "./server/stores/memorySsoStore.d.ts",
      "default": "./server/stores/memorySsoStore.js"
    },
    "./stores/cloudflare-d1-sso": {
      "types": "./server/stores/cloudflareD1SsoStore.d.ts",
      "default": "./server/stores/cloudflareD1SsoStore.js"
    },
    "./react": {
      "types": "./client/react/index.d.ts",
      "default": "./client/react/index.js"
    },
    "./audit": {
      "default": "./server/core/auditLogService.js",
      "types": "./server/core/auditLogService.d.ts"
    },
    "./stores/memory-audit": {
      "types": "./server/stores/memoryAuditLogStore.d.ts",
      "default": "./server/stores/memoryAuditLogStore.js"
    },
    "./stores/cloudflare-d1-audit": {
      "types": "./server/stores/cloudflareD1AuditLogStore.d.ts",
      "default": "./server/stores/cloudflareD1AuditLogStore.js"
    },
    "./apikeys": {
      "default": "./server/core/apiKeyService.js",
      "types": "./server/core/apiKeyService.d.ts"
    },
    "./stores/memory-apikeys": {
      "types": "./server/stores/memoryApiKeyStore.d.ts",
      "default": "./server/stores/memoryApiKeyStore.js"
    },
    "./stores/cloudflare-d1-apikeys": {
      "types": "./server/stores/cloudflareD1ApiKeyStore.d.ts",
      "default": "./server/stores/cloudflareD1ApiKeyStore.js"
    },
    "./sessions": {
      "default": "./server/core/sessionService.js",
      "types": "./server/core/sessionService.d.ts"
    }
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "server",
    "client",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node example.js",
    "dev": "nodemon example.js",
    "test": "node test_auth.js && node test_redis_refresh_token_store.js && node test_mfa.js && node test_passkeys.js && node test_cloudflare.js && node test_dpop.js && node test_organizations.js && node test_webhooks.js && node test_sso_scim.js && node test_v2_features.js",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GautamSharma-coder/devauthkit.git"
  },
  "bugs": {
    "url": "https://github.com/GautamSharma-coder/devauthkit/issues"
  },
  "homepage": "https://gautamsharma-coder.github.io/devauthkit/docs.html",
  "keywords": [
    "auth",
    "authentication",
    "express",
    "cloudflare",
    "hono",
    "jwt",
    "session",
    "email",
    "otp",
    "passkeys",
    "webauthn",
    "passwordless",
    "sso",
    "saml",
    "scim",
    "enterprise",
    "sdk"
  ],
  "author": "Gautam Sharma",
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "hono": "^4.13.13",
    "miniflare": "^4.20260730.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.29.1",
    "ws": "^8.22.0"
  }
}
